# ---------------------------------------------------------------------------
# Conversa CRM — variables de entorno
# Copia este archivo a .env.local y rellena solo lo que vayas a usar.
# ---------------------------------------------------------------------------

# Aplicación
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_NAME=Conversa CRM
DEFAULT_WORKSPACE_ID=default

# Clave para cifrar credenciales de canales guardadas desde la UI.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY=

# Base de datos. Si se deja vacía se usa almacenamiento local JSON (.data/).
# En Vercel usar una cadena de conexión de Neon/Supabase/Neon con pgvector.
DATABASE_URL=

# Motor conversacional (opcional). Compatible con OpenAI y Ollama/OpenAI-like.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
BOT_AUTO_REPLY=false
BOT_CONFIDENCE_THRESHOLD=0.75

# ---------------------------------------------------------------------------
# Canales de mensajería (ID + credenciales)
# También se pueden introducir desde la UI en /integraciones (cifradas en DB).
# ---------------------------------------------------------------------------

# WhatsApp Cloud API (Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=

# Telegram Bot API
TELEGRAM_BOT_TOKEN=

# Instagram / Facebook Messenger (Meta Graph API)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_SECRET=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Email entrante vía webhook (Resend/Postmark/Mailgun)
EMAIL_INBOUND_WEBHOOK_SECRET=
EMAIL_FROM_ADDRESS=

# SMS / Voz (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Web widget: secreto opcional paravalidar identidad (HMAC)
WIDGET_IDENTITY_SECRET=
